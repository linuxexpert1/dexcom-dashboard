# Copy to .env and fill in. NEVER commit .env.
# Dexcom Share credentials (the same login the Dexcom Follow app uses).
# Use either DEXCOM_USERNAME (email or phone, e.g. +11234567890) or DEXCOM_ACCOUNT_ID.
DEXCOM_USERNAME=
DEXCOM_ACCOUNT_ID=
DEXCOM_PASSWORD=
# us (default), ous (outside US), or jp
DEXCOM_REGION=us

# Set to 1 to run without Dexcom and generate realistic sample data (also used by the GitHub Pages demo)
DEMO_MODE=0

# Optional: if set, every /api request must send  Authorization: Bearer <token>
# (or ?token=<token>). Leave empty for no auth on a trusted LAN.
API_TOKEN=

# Target range (mg/dL) used for coloring and time-in-range stats
TARGET_LOW=70
TARGET_HIGH=180
URGENT_LOW=55
URGENT_HIGH=250

# Polling and storage
POLL_SECONDS=300
DB_PATH=./data/glucose.db
HOST=0.0.0.0
PORT=8080
